/// Una fila por corrida y sitio (RF-07).
table fact_ejecucion
	lineageTag: 14ca82e4-5905-5a72-89c7-95663452803e

	measure Ejecuciones = COUNTROWS ( fact_ejecucion )
		formatString: #,0
		displayFolder: Ejecuciones
		lineageTag: 1b5aae15-69bb-53ca-bba8-cb37d7d9f30a

	measure 'Ejecuciones fallidas' = IF ( NOT ISBLANK ( COUNTROWS ( fact_ejecucion ) ), CALCULATE ( COUNTROWS ( fact_ejecucion ), fact_ejecucion[estado] = "FALLIDA" ) + 0 )
		formatString: #,0
		displayFolder: Ejecuciones
		lineageTag: 51a6a74c-0b3f-5f4d-93a2-32c952008926

	measure 'Tasa de éxito' = DIVIDE ( CALCULATE ( COUNTROWS ( fact_ejecucion ), fact_ejecucion[estado] = "EXITOSA" ), COUNTROWS ( fact_ejecucion ) )
		formatString: 0.0%
		displayFolder: Ejecuciones
		lineageTag: aefdb6c2-f157-596e-8bae-96d8c7e2138f

	measure 'Duración promedio (min)' = AVERAGE ( fact_ejecucion[duracion_s] ) / 60
		formatString: #,0.0
		displayFolder: Ejecuciones
		lineageTag: f0bc436d-7377-5c30-84d1-66bccff83d48

