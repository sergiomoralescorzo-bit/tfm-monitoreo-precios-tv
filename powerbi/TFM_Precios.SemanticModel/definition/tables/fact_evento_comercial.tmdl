/// Eventos comerciales de las alertas y el resumen diario (src/medallon/eventos.py): tipo × producto × tienda × día.
table fact_evento_comercial
	lineageTag: c0f5d421-95ba-5614-88b2-1e260adbab4a

	measure Eventos = COUNTROWS ( fact_evento_comercial )
		formatString: #,0
		displayFolder: Eventos
		lineageTag: 8c17ddd7-06ae-5f3c-857f-d39da37ec54f

	measure 'Cambios de precio' = CALCULATE ( [Eventos], fact_evento_comercial[tipo_evento] = "CAMBIO_PRECIO" )
		formatString: #,0
		displayFolder: Eventos
		lineageTag: 6ea8ce85-b3b1-5442-a41f-1c3af202e7ed

	measure Agotados = CALCULATE ( [Eventos], fact_evento_comercial[tipo_evento] = "AGOTADO" )
		formatString: #,0
		displayFolder: Eventos
		lineageTag: a6074d8c-a3d5-52f6-a8c9-22e88c1e608f

	measure 'Fin de promoción' = CALCULATE ( [Eventos], fact_evento_comercial[tipo_evento] = "FIN_PROMOCION" )
		formatString: #,0
		displayFolder: Eventos
		lineageTag: 6dd49e7e-4f8e-5ae9-bd6d-e102d4aefc03

	measure 'Productos nuevos' = CALCULATE ( [Eventos], fact_evento_comercial[tipo_evento] = "PRODUCTO_NUEVO" )
		formatString: #,0
		displayFolder: Eventos
		lineageTag: 728c8923-30fb-57b4-b3c5-8a5c0e6427d6

	measure 'Descuentos sin respaldo nuevos' = CALCULATE ( [Eventos], fact_evento_comercial[tipo_evento] = "DESCUENTO_SIN_RESPALDO" )
