	partition fact_precio_diario = m
		mode: import
		source =
				let
				    Origen = Sql.Database(Servidor, BaseDatos),
				    Vista = Origen{[Schema = "oro", Item = "fact_precio_diario"]}[Data]
				in
				    Vista

	annotation PBI_ResultType = Table

