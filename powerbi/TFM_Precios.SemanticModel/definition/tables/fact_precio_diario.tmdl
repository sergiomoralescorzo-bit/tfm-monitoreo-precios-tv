/// Producto × tienda × día, con la última captura del día (RF-06). Trazable hasta bronce (ruta_bronze).
table fact_precio_diario
	lineageTag: 5011e0a3-4700-5089-97bf-b20abe21d40f

	measure Ofertas = COUNTROWS ( fact_precio_diario )
		formatString: #,0
		displayFolder: Precios
		lineageTag: 96e50b4d-a451-549c-8553-d057bb0ad362

	measure Productos = DISTINCTCOUNT ( fact_precio_diario[producto_key] )
		formatString: #,0
		displayFolder: Precios
		lineageTag: 0d44a9c3-1c5f-5474-b052-171866809958

	measure 'Precio mínimo' = CALCULATE ( MIN ( fact_precio_diario[precio_venta] ), fact_precio_diario[disponible] = TRUE () )
		formatString: \$ #,0
		displayFolder: Precios
		lineageTag: beaf955b-34cb-567b-b29d-1f4b9e6c45f1

	measure 'Precio promedio' = CALCULATE ( AVERAGE ( fact_precio_diario[precio_venta] ), fact_precio_diario[disponible] = TRUE () )
		formatString: \$ #,0
		displayFolder: Precios
		lineageTag: dc5887dc-68e1-5a39-a20f-9de1ae03135e

	measure 'Precio máximo' = CALCULATE ( MAX ( fact_precio_diario[precio_venta] ), fact_precio_diario[disponible] = TRUE () )
		formatString: \$ #,0
		displayFolder: Precios
		lineageTag: 39bba077-1596-5649-a1fc-e4680fbf7aa8

	measure 'Descuento promedio' = AVERAGE ( fact_precio_diario[descuento_pct] )
		formatString: 0.0%
		displayFolder: Precios
		lineageTag: 084eb59a-ee29-5f0f-a416-293db6afbb1a

	measure 'Última fecha con precio' = CALCULATE ( MAX ( fact_precio_diario[fecha_key] ), ALLSELECTED ( dim_calendario ), fact_precio_diario[disponible] = TRUE () )
		formatString: 0
		displayFolder: Precios
		lineageTag: 5d111693-3cd6-5bf8-80e2-61d37496b1bd

	measure 'Precio mínimo último día' =
			VAR _fecha = [Última fecha con precio]
			RETURN
			    CALCULATE ( [Precio mínimo], dim_calendario[fecha_key] = _fecha )
		formatString: \$ #,0
		displayFolder: Precios
		lineageTag: 020b50ec-0de3-5d80-85e6-53698fbcfedc

	measure 'Tienda más barata' =
			VAR _fecha = [Última fecha con precio]
			VAR _precio = [Precio mínimo último día]
			RETURN
			    IF (
			        NOT ISBLANK ( _precio ),
			        CONCATENATEX (
			            FILTER (
			                VALUES ( dim_tienda[tienda] ),
			                CALCULATE (
			                    COUNTROWS ( fact_precio_diario ),
			                    dim_calendario[fecha_key] = _fecha,
			                    fact_precio_diario[precio_venta] = _precio,
			                    fact_precio_diario[disponible] = TRUE ()
			                ) > 0
			            ),
			            dim_tienda[tienda],
			            ", ",
			            dim_tienda[tienda], ASC
			        )
			    )
		displayFolder: Precios
		lineageTag: febb352a-db51-594d-b2fe-a1a194dd95af

	measure 'Tiendas con oferta' = CALCULATE ( DISTINCTCOUNT ( fact_precio_diario[tienda_key] ), fact_precio_diario[disponible] = TRUE () )
		formatString: #,0
		displayFolder: Precios
		lineageTag: 8033530b-1a63-51c5-b46d-519d69b49126

	measure 'Precios atípicos' = IF ( NOT ISBLANK ( COUNTROWS ( fact_precio_diario ) ), CALCULATE ( COUNTROWS ( fact_precio_diario ), NOT ISBLANK ( fact_precio_diario[motivos_atipico] ) ) + 0 )
		formatString: #,0
		displayFolder: Calidad
		lineageTag: f49acbf2-23f7-51be-a73c-4c10be37b7ab

	measure 'Enlace tienda más barata' =
			VAR _fecha = [Última fecha con precio]
			VAR _precio = [Precio mínimo último día]
			VAR _filas =
			    CALCULATETABLE (
			        SUMMARIZE ( fact_precio_diario, dim_tienda[tienda], fact_precio_diario[url] ),
			        dim_calendario[fecha_key] = _fecha,
			        fact_precio_diario[precio_venta] = _precio,
			        fact_precio_diario[disponible] = TRUE ()
			    )
			RETURN
			    IF (
			        NOT ISBLANK ( _precio ),
			        IF (
			            [Sin existencias en la última captura] = 1,
			            "Sin existencias",
			            MAXX ( TOPN ( 1, _filas, dim_tienda[tienda], ASC ), fact_precio_diario[url] )
			        )
			    )
		displayFolder: Precios
		lineageTag: d709f32d-460f-446b-a2cf-6884d0778175
		dataCategory: WebUrl

	/// Fecha y hora (Colombia, UTC−5) de la captura más reciente cargada en oro; no depende de los filtros.
	measure 'Última actualización' =
			VAR _ultima = CALCULATE ( MAX ( fact_precio_diario[fecha_captura_utc] ), ALL ( fact_precio_diario ) )
			VAR _local = _ultima - 5 / 24
			VAR _hora = HOUR ( _local )
			RETURN
			    IF (
			        NOT ISBLANK ( _ultima ),
			        FORMAT ( _local, "dd/mm/yyyy" ) & "  " & ( MOD ( _hora + 11, 12 ) + 1 ) & ":"
			            & FORMAT ( MINUTE ( _local ), "00" ) & IF ( _hora < 12, " a. m.", " p. m." )
			    )
		displayFolder: Precios
		lineageTag: 1f74d3d5-ef01-45a0-b395-03dd6209bc13

	/// Ofertas con existencias, descuento anunciado y al menos 20 días observados en la ventana de 30.
	measure 'Ofertas evaluables' = CALCULATE ( COUNTROWS ( fact_precio_diario ), NOT ISBLANK ( fact_precio_diario[descuento_sin_respaldo] ) )
		formatString: #,0
		displayFolder: Detector
		lineageTag: a753ce85-aef0-58bd-a825-7739ecef3de8

	/// Ofertas cuyo descuento anunciado supera al respaldado en más de 5 puntos porcentuales.
	measure 'Descuentos sin respaldo' = CALCULATE ( COUNTROWS ( fact_precio_diario ), fact_precio_diario[descuento_sin_respaldo] = TRUE () )
		formatString: #,0
		displayFolder: Detector
		lineageTag: 2aec3d8f-06f9-52b9-9a8a-ea236ad5d476

	/// Descuentos sin respaldo sobre ofertas evaluables.
	measure '% sin respaldo' = DIVIDE ( [Descuentos sin respaldo], [Ofertas evaluables] )
		formatString: 0.0%
		displayFolder: Detector
		lineageTag: 57ba1b1d-56a2-50a3-81eb-4fddd2d95fe5

	/// 1 − venta / lista, promedio de las ofertas evaluables.
	measure 'Descuento anunciado (evaluables)' = CALCULATE ( AVERAGE ( fact_precio_diario[descuento_pct] ), NOT ISBLANK ( fact_precio_diario[descuento_sin_respaldo] ) )
		formatString: 0.0%
		displayFolder: Detector
		lineageTag: 94c0955e-ca84-577c-8122-04d58478eac6

	/// 1 − venta / menor precio de los 30 días anteriores, promedio de las ofertas evaluables.
	measure 'Descuento respaldado promedio' = AVERAGE ( fact_precio_diario[descuento_respaldado] )
		formatString: 0.0%
		displayFolder: Detector
		lineageTag: de9515b9-8fd2-5176-b476-a5471288f0f7

	/// Producto que tuvo existencias en el periodo pero no en la última captura (agotado o ya no publicado).
	measure 'Sin existencias en la última captura' =
			VAR _ultima = CALCULATE ( MAX ( fact_precio_diario[fecha_key] ), ALLSELECTED ( dim_calendario ), REMOVEFILTERS ( dim_producto ) )
			VAR _fecha = [Última fecha con precio]
			RETURN
			    IF ( NOT ISBLANK ( _fecha ), IF ( _fecha < _ultima, 1, 0 ) )
		formatString: 0
		displayFolder: Precios
		lineageTag: 89ea4f65-95ec-55b6-8ab1-a0ac2342bcaa

	/// Color de fondo de la fila en la tabla de Resumen: rojo suave si no hay existencias en la última captura.
	measure 'Color fila sin existencias' = IF ( [Sin existencias en la última captura] = 1, "#FDE2E2" )
		displayFolder: Precios
		lineageTag: 56044cb7-be25-523e-91fa-295aa3a57183

	column fecha_key
