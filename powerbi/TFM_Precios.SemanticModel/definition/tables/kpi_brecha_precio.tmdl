/// Producto × día con al menos 2 cadenas y stock: mínimo, máximo y brecha entre cadenas.
table kpi_brecha_precio
	lineageTag: 0e033bed-5699-5a43-adbf-79884c9066d8

	measure 'Productos comparados' = DISTINCTCOUNT ( kpi_brecha_precio[producto_key] )
		formatString: #,0
		displayFolder: Brecha entre cadenas
		lineageTag: 4a5a7ed1-0979-52d0-abbf-dd753374042d

	measure 'Brecha promedio %' = AVERAGE ( kpi_brecha_precio[brecha_pct] )
		formatString: 0.0%
		displayFolder: Brecha entre cadenas
		lineageTag: ca5f844d-8c19-5bb2-9680-8e9c49056c66

	measure 'Brecha máxima %' = MAX ( kpi_brecha_precio[brecha_pct] )
		formatString: 0.0%
		displayFolder: Brecha entre cadenas
		lineageTag: 3b977751-06af-5479-a37c-9acdfb631647

	measure 'Brecha promedio $' = AVERAGE ( kpi_brecha_precio[brecha_abs] )
		formatString: \$ #,0
		displayFolder: Brecha entre cadenas
		lineageTag: 82a739e4-72b9-5c23-81f1-1403562907cd

	measure 'Veces más barata' = COUNTROWS ( kpi_brecha_precio )
		formatString: #,0
		displayFolder: Brecha entre cadenas
		lineageTag: fa82431c-6553-5311-8229-854fb9892a72

	measure 'Brecha último día %' =
			VAR _fecha = [Última fecha con precio]
			RETURN
			    CALCULATE ( MAX ( kpi_brecha_precio[brecha_pct] ), dim_calendario[fecha_key] = _fecha )
		formatString: 0.0%
		displayFolder: Brecha entre cadenas
		lineageTag: ca2b7a14-28c1-5473-b285-44f50981d251

	column fecha_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 879e7eb6-013b-578c-8657-51a1c3273664
		summarizeBy: none
		sourceColumn: fecha_key

		annotation SummarizationSetBy = User

	column producto_key
