/// Tienda × día (última corrida): completitud y emparejamiento (Etapa 1, sección 10).
table kpi_calidad_captura
	lineageTag: 60e6027b-7229-58bd-82ac-bfb6921fec92

	measure 'Emparejamiento %' = DIVIDE ( SUM ( kpi_calidad_captura[emparejadas] ), SUM ( kpi_calidad_captura[ofertas_con_stock] ) )
		formatString: 0.0%
		displayFolder: Calidad
		lineageTag: 0097f953-48cc-5f2a-adfb-f7b2b739aaa3

	measure 'Completitud %' =
			DIVIDE (
			    SUMX ( kpi_calidad_captura, kpi_calidad_captura[completitud_pct] * kpi_calidad_captura[registros_con_datos] ),
			    SUM ( kpi_calidad_captura[registros_con_datos] )
			)
		formatString: 0.0%
		displayFolder: Calidad
		lineageTag: fa584674-aecc-5b31-b452-3376d131e133

	measure 'Registros capturados' = SUM ( kpi_calidad_captura[registros] )
		formatString: #,0
		displayFolder: Calidad
		lineageTag: cd2c8fb2-a0c2-536f-8c47-98a6d2f81076

