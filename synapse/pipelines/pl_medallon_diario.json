{
  "name": "pl_medallon_diario",
  "properties": {
    "description": "Transformación diaria de bronce, plata y oro (antes pl_medallon_semanal, renombrada el 6-nov-2026 porque corre a diario desde el 19-oct). Inicia el Container Apps Job caj-tfm-medallon (Spark 3.4 local con src/medallon: bronce/conformidad, plata y oro) y espera a que termine.",
    "variables": {
      "ejecucion": {
        "type": "String"
      },
      "estado": {
        "type": "String",
        "defaultValue": "Running"
      }
    },
    "activities": [
      {
        "name": "Iniciar medallon",
        "type": "WebActivity",
        "policy": {
          "timeout": "0.00:05:00",
          "retry": 2,
          "retryIntervalInSeconds": 60
        },
        "typeProperties": {
          "method": "POST",
          "url": "https://management.azure.com/subscriptions/__SUSCRIPCION__/resourceGroups/__GRUPO__/providers/Microsoft.App/jobs/__JOB_MEDALLON__/start?api-version=2024-03-01",
          "body": "{}",
          "disableAsyncPattern": true,
          "authentication": {
            "type": "MSI",
            "resource": "https://management.azure.com/"
          }
        }
      },
      {
        "name": "Guardar ejecucion",
        "type": "SetVariable",
        "dependsOn": [
          {
            "activity": "Iniciar medallon",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "variableName": "ejecucion",
          "value": {
            "value": "@activity('Iniciar medallon').output.name",
            "type": "Expression"
          }
        }
      },
      {
        "name": "Esperar fin",
        "type": "Until",
        "dependsOn": [
          {
            "activity": "Guardar ejecucion",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "value": "@not(equals(variables('estado'), 'Running'))",
            "type": "Expression"
          },
          "timeout": "0.01:15:00",
          "activities": [
            {
              "name": "Pausa",
              "type": "Wait",
              "typeProperties": {
                "waitTimeInSeconds": 60
              }
            },
            {
              "name": "Consultar ejecucion",
              "type": "WebActivity",
              "dependsOn": [
                {
                  "activity": "Pausa",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "policy": {
                "timeout": "0.00:02:00",
                "retry": 2,
                "retryIntervalInSeconds": 30
              },
              "typeProperties": {
                "method": "GET",
                "url": {
                  "value": "@concat('https://management.azure.com/subscriptions/__SUSCRIPCION__/resourceGroups/__GRUPO__/providers/Microsoft.App/jobs/__JOB_MEDALLON__/executions/', variables('ejecucion'), '?api-version=2024-03-01')",
                  "type": "Expression"
                },
                "authentication": {
                  "type": "MSI",
                  "resource": "https://management.azure.com/"
                }
              }
            },
            {
              "name": "Actualizar estado",
              "type": "SetVariable",
              "dependsOn": [
                {
                  "activity": "Consultar ejecucion",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "typeProperties": {
                "variableName": "estado",
                "value": {
                  "value": "@if(contains(createArray('Running', 'Processing', 'Unknown'), activity('Consultar ejecucion').output.properties.status), 'Running', activity('Consultar ejecucion').output.properties.status)",
                  "type": "Expression"
                }
              }
            }
          ]
        }
      },
      {
        "name": "Verificar resultado",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "Esperar fin",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "value": "@not(equals(variables('estado'), 'Succeeded'))",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "name": "Medallon fallido",
              "type": "Fail",
              "typeProperties": {
                "message": {
                  "value": "@concat('La ejecución ', variables('ejecucion'), ' terminó en estado ', variables('estado'))",
                  "type": "Expression"
                },
                "errorCode": "MEDALLON_FALLIDO"
              }
            }
          ]
        }
      },
      {
        "name": "Avisar fallo - Iniciar medallon",
        "type": "ExecutePipeline",
        "dependsOn": [
          {
            "activity": "Iniciar medallon",
            "dependencyConditions": [
              "Failed"
            ]
          }
        ],
        "typeProperties": {
          "pipeline": {
            "referenceName": "pl_notificar_fallo",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true,
          "parameters": {
            "pipeline": {
              "value": "@pipeline().Pipeline",
              "type": "Expression"
            },
            "ejecucion": {
              "value": "@pipeline().RunId",
              "type": "Expression"
            },
            "actividad": "Iniciar medallon",
            "error": {
              "value": "@activity('Iniciar medallon').error.message",
              "type": "Expression"
            }
          }
        }
      },
      {
        "name": "Fallo - Iniciar medallon",
        "type": "Fail",
        "description": "Deja la pipeline en Failed aunque el aviso se haya enviado (si no, la rama de fallo la daría por exitosa).",
        "dependsOn": [
          {
            "activity": "Avisar fallo - Iniciar medallon",
            "dependencyConditions": [
              "Succeeded",
              "Failed"
            ]
          }
        ],
        "typeProperties": {
          "message": {
            "value": "@activity('Iniciar medallon').error.message",
            "type": "Expression"
          },
          "errorCode": "PIPELINE_FALLIDA"
        }
      },
      {
        "name": "Avisar fallo - Guardar ejecucion",
        "type": "ExecutePipeline",
        "dependsOn": [
          {
            "activity": "Guardar ejecucion",
            "dependencyConditions": [
              "Failed"
            ]
          }
        ],
        "typeProperties": {
          "pipeline": {
            "referenceName": "pl_notificar_fallo",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true,
          "parameters": {
            "pipeline": {
              "value": "@pipeline().Pipeline",
              "type": "Expression"
            },
            "ejecucion": {
              "value": "@pipeline().RunId",
              "type": "Expression"
            },
            "actividad": "Guardar ejecucion",
            "error": {
              "value": "@activity('Guardar ejecucion').error.message",
              "type": "Expression"
            }
          }
        }
      },
      {
        "name": "Fallo - Guardar ejecucion",
        "type": "Fail",
        "description": "Deja la pipeline en Failed aunque el aviso se haya enviado (si no, la rama de fallo la daría por exitosa).",
        "dependsOn": [
          {
            "activity": "Avisar fallo - Guardar ejecucion",
            "dependencyConditions": [
              "Succeeded",
              "Failed"
            ]
          }
        ],
        "typeProperties": {
          "message": {
            "value": "@activity('Guardar ejecucion').error.message",
            "type": "Expression"
          },
          "errorCode": "PIPELINE_FALLIDA"
        }
      },
      {
        "name": "Avisar fallo - Esperar fin",
        "type": "ExecutePipeline",
        "dependsOn": [
          {
            "activity": "Esperar fin",
            "dependencyConditions": [
              "Failed"
            ]
          }
        ],
        "typeProperties": {
          "pipeline": {
            "referenceName": "pl_notificar_fallo",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true,
          "parameters": {
            "pipeline": {
              "value": "@pipeline().Pipeline",
              "type": "Expression"
            },
            "ejecucion": {
              "value": "@pipeline().RunId",
              "type": "Expression"
            },
            "actividad": "Esperar fin",
            "error": {
              "value": "@activity('Esperar fin').error.message",
              "type": "Expression"
            }
          }
        }
      },
      {
        "name": "Fallo - Esperar fin",
        "type": "Fail",
        "description": "Deja la pipeline en Failed aunque el aviso se haya enviado (si no, la rama de fallo la daría por exitosa).",
        "dependsOn": [
          {
            "activity": "Avisar fallo - Esperar fin",
            "dependencyConditions": [
              "Succeeded",
              "Failed"
            ]
          }
        ],
        "typeProperties": {
          "message": {
            "value": "@activity('Esperar fin').error.message",
            "type": "Expression"
          },
          "errorCode": "PIPELINE_FALLIDA"
        }
      },
      {
        "name": "Avisar fallo - Verificar resultado",
        "type": "ExecutePipeline",
        "dependsOn": [
          {
            "activity": "Verificar resultado",
            "dependencyConditions": [
              "Failed"
            ]
          }
        ],
        "typeProperties": {
          "pipeline": {
            "referenceName": "pl_notificar_fallo",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true,
          "parameters": {
            "pipeline": {
              "value": "@pipeline().Pipeline",
              "type": "Expression"
            },
            "ejecucion": {
              "value": "@pipeline().RunId",
              "type": "Expression"
            },
            "actividad": "Verificar resultado",
            "error": {
              "value": "@activity('Verificar resultado').error.message",
              "type": "Expression"
            }
          }
        }
      },
      {
        "name": "Fallo - Verificar resultado",
        "type": "Fail",
        "description": "Deja la pipeline en Failed aunque el aviso se haya enviado (si no, la rama de fallo la daría por exitosa).",
        "dependsOn": [
          {
            "activity": "Avisar fallo - Verificar resultado",
            "dependencyConditions": [
              "Succeeded",
              "Failed"
            ]
          }
        ],
        "typeProperties": {
          "message": {
            "value": "@activity('Verificar resultado').error.message",
            "type": "Expression"
          },
          "errorCode": "PIPELINE_FALLIDA"
        }
      }
    ]
  }
}
