{
  "name": "pl_medallon_synapse",
  "properties": {
    "description": "Alternativa con Synapse Spark (opción A): procesa el medallón con el notebook nb_medallon_semanal en el pool sptfm. Requiere cuota de vCores de Spark en el área de trabajo.",
    "activities": [
      {
        "name": "Medallon semanal",
        "type": "SynapseNotebook",
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 0
        },
        "typeProperties": {
          "notebook": {
            "referenceName": "nb_medallon_semanal",
            "type": "NotebookReference"
          },
          "parameters": {
            "cuenta": {
              "value": "__CUENTA__",
              "type": "string"
            },
            "contenedor": {
              "value": "__CONTENEDOR__",
              "type": "string"
            }
          },
          "snapshot": true,
          "sparkPool": {
            "referenceName": "__POOL__",
            "type": "BigDataPoolReference"
          }
        }
      },
      {
        "name": "Avisar fallo - Medallon semanal",
        "type": "ExecutePipeline",
        "dependsOn": [
          {
            "activity": "Medallon semanal",
            "dependencyConditions": [
              "Failed"
            ]
          }
        ],
        "typeProperties": {
          "pipeline": {
            "referenceName": "pl_notificar_fallo",
            "type": "PipelineReference"
          },
          "waitOnCompletion": true,
          "parameters": {
            "pipeline": {
              "value": "@pipeline().Pipeline",
              "type": "Expression"
            },
            "ejecucion": {
              "value": "@pipeline().RunId",
              "type": "Expression"
            },
            "actividad": "Medallon semanal",
            "error": {
              "value": "@activity('Medallon semanal').error.message",
              "type": "Expression"
            }
          }
        }
      },
      {
        "name": "Fallo - Medallon semanal",
        "type": "Fail",
        "description": "Deja la pipeline en Failed aunque el aviso se haya enviado (si no, la rama de fallo la daría por exitosa).",
        "dependsOn": [
          {
            "activity": "Avisar fallo - Medallon semanal",
            "dependencyConditions": [
              "Succeeded",
              "Failed"
            ]
          }
        ],
        "typeProperties": {
          "message": {
            "value": "@activity('Medallon semanal').error.message",
            "type": "Expression"
          },
          "errorCode": "PIPELINE_FALLIDA"
        }
      }
    ]
  }
}
